# Local Docker Compose development settings. Copy this file to .env.
POSTGRES_PASSWORD=local-dev-password
DATABASE_URL=postgresql+asyncpg://tracker:local-dev-password@db:5432/sales_tracker
SYNC_DATABASE_URL=postgresql://tracker:local-dev-password@db:5432/sales_tracker

# The API seeds this account on first startup.
SECRET_KEY=local-development-secret-key-change-me
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=admin12345

# Local HTTP requires non-secure refresh cookies.
PUBLIC_APP_URL=http://localhost:3010
CORS_ORIGINS=http://localhost:3010
AUTH_COOKIE_SECURE=false
AUTH_EMAIL_VERIFICATION_ENABLED=false

# Optional integrations are disabled for local development.
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MINI_APP_URL=http://localhost:3010/tg
OPENAI_API_KEY=
AI_REDIS_URL=redis://redis:6379/0
AI_MODEL_REGISTRY_JSON=
ENTERPRISE_TOOLS_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AGENT_RATES_API_KEY=
CHIMEGE_API_TOKEN=
CHIMEGE_TTS_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

ATTACHMENT_STORAGE_BACKEND=local
CLAMAV_ENABLED=false
