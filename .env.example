# Core
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+asyncpg://tracker:password@db:5432/sales_tracker
SYNC_DATABASE_URL=postgresql://tracker:password@db:5432/sales_tracker
SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_EMAIL=admin
ADMIN_USERNAME=
ADMIN_PASSWORD=replace-on-first-login
PUBLIC_APP_URL=https://erp.oyuns.mn
CORS_ORIGINS=https://erp.oyuns.mn
    WORKTIME_QR_SIGNING_SECRET=replace-with-a-separate-random-32-byte-secret
    WORKTIME_QR_REDIS_URL=redis://redis:6379/0
AUTH_EMAIL_VERIFICATION_ENABLED=false
AUTH_COOKIE_SECURE=true
TELEGRAM_REFRESH_TOKEN_DAYS=365

# Resend authentication email (sending-only API key)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=re_replace_with_resend_sending_key
SMTP_FROM=OYUNS Workspace <auth@example.com>

# Attachments: private Dokploy/VPS volume
ATTACHMENT_STORAGE_BACKEND=local
AVATAR_MAX_BYTES=2097152
AVATAR_MAX_PIXELS=256
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

# Google Calendar web OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://erp.oyuns.mn/api/v1/integrations/google-calendar/callback
GOOGLE_WEBHOOK_URL=https://erp.oyuns.mn/api/v1/integrations/google-calendar/webhook

# Existing Telegram/AI providers
BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MINI_APP_URL=https://erp.oyuns.mn/tg
MANAGER_TG_ID=306983322
OPENAI_API_KEY=
ENTERPRISE_TOOLS_ENABLED=false
# Disabled until the edge has a dedicated HTTPS domain and a canary tenant.
# Generate MCP_INTERNAL_SHARED_SECRET independently from SECRET_KEY.
AI_MCP_ENABLED=false
AI_MCP_SERVER_URL=https://mcp.example.com/mcp
AI_MCP_ORGANIZATION_ALLOWLIST=
MCP_EDGE_PORT=8011
MCP_TOKEN_ISSUER=oyuns
MCP_EXECUTOR_URL=http://backend:8000/v1/mcp-executor
MCP_INTERNAL_SHARED_SECRET=replace-with-a-second-long-random-secret
MCP_INTERNAL_REQUIRE_MTLS=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AGENT_RATES_API_KEY=
CHIMEGE_API_TOKEN=
CHIMEGE_TTS_API_TOKEN=
